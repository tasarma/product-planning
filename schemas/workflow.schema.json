{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/product-planning/schemas/workflow.schema.json",
  "title": "product-planning workflow.yaml",
  "description": "Per-project configuration for the product-planning plugin. Must not contain secrets; tracker auth comes from MCP servers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "prioritization", "tracker"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "goal"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1, "pattern": "^[^\\n]+$" }
      }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "goals": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "description"],
        "properties": {
          "type": { "type": "string", "enum": ["compliance", "regulatory", "technical", "business", "other"] },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prioritization": { "type": "string", "enum": ["RICE", "MoSCoW", "WSJF", "value-effort"] },
    "estimation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": { "type": "string", "enum": ["story_points", "t-shirt", "none"], "default": "story_points" },
        "scale": { "type": "array", "items": { "type": ["integer", "number", "string"] } }
      }
    },
    "ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "epic_prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*$", "default": "EPIC" },
        "story_prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*$", "default": "US" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "research": { "type": "string", "default": "product/research" },
        "roadmap": { "type": "string", "default": "product/roadmap.md" },
        "backlog": { "type": "string", "default": "product/backlog" },
        "stories": { "type": "string", "default": "product/stories" },
        "archive": { "type": "string", "default": "product/archive" }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brief": { "type": "string" },
        "roadmap": { "type": "string" },
        "epic": { "type": "string" },
        "story": { "type": "string" }
      }
    },
    "writing_style": {
      "type": "string",
      "enum": ["ste", "plain-english", "none"],
      "default": "ste",
      "description": "Style for prose in generated docs. Rules: references/writing-styles/<style>.md in the plugin."
    },
    "glossary": {
      "type": "string",
      "minLength": 1,
      "description": "Optional path to the project glossary (markdown table: Term | Definition | Do not use). Read if it exists; default product/glossary.md."
    },
    "definition_of_ready": { "type": "array", "items": { "type": "string" } },
    "definition_of_done": { "type": "array", "items": { "type": "string" } },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["github", "jira", "none"] },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo"],
          "properties": {
            "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
            "labels": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "epic": { "type": "string", "default": "epic" },
                "story": { "type": "string", "default": "user-story" },
                "extra": { "type": "array", "items": { "type": "string" } }
              }
            },
            "milestone": { "type": ["string", "integer"] },
            "project": { "type": "string" }
          }
        },
        "jira": {
          "type": "object",
          "additionalProperties": false,
          "required": ["site", "project_key"],
          "properties": {
            "site": { "type": "string", "pattern": "^[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$" },
            "project_key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
            "issue_types": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "epic": { "type": "string", "default": "Epic" },
                "story": { "type": "string", "default": "Story" }
              }
            },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "acceptance_criteria": { "type": "string", "pattern": "^(description|customfield_[0-9]+)$", "default": "description" },
                "story_points": { "type": ["string", "null"], "pattern": "^customfield_[0-9]+$" }
              }
            },
            "epic_link": { "type": "string", "pattern": "^(parent|customfield_[0-9]+)$", "default": "parent" }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "github" } } }, "then": { "required": ["github"] } },
        { "if": { "properties": { "type": { "const": "jira" } } }, "then": { "required": ["jira"] } }
      ]
    }
  }
}
